# Copy this file to .env and fill in real values. Never commit .env itself.

# --- MySQL (account credentials) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=authentication
# true for cloud MySQL that requires TLS (Aiven, TiDB Cloud)
MYSQL_SSL=false

# --- MongoDB (extended profile data) ---
# Local MongoDB Community Server (default port 27017). For Atlas use the mongodb+srv:// string instead.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=authentication

# --- Redis (login sessions) ---
# Upstash (free): console -> your database -> "Connect" -> copy the rediss:// URL.
# Easiest: just set REDIS_URL (leave the others blank).
REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379
#
# Or, separate values (local Redis: host 127.0.0.1, scheme tcp, no password):
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SCHEME=tls


# prehost push values
MYSQL_HOST=sql204.ezyro.com
MYSQL_USER=ezyro_43245102
MYSQL_PASSWORD=
MYSQL_DATABASE=ezyro_43245102_authentication
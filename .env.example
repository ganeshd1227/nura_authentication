# Copy this file to .env and fill in real values. Never commit .env itself.

# --- MySQL (account credentials) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=authentication
# true for cloud MySQL that requires TLS (Aiven, TiDB Cloud)
MYSQL_SSL=false

# --- MongoDB (extended profile data) ---
# Local MongoDB Community Server (default port 27017). For Atlas use the mongodb+srv:// string instead.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=authentication

# --- Redis (login sessions) ---
# Free instance: https://redis.io/try-free/ or https://upstash.com
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# tls for Redis Cloud / Upstash, tcp for a local Redis
REDIS_SCHEME=tcp
REDIS_PASSWORD=
